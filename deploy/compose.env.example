# docker compose environment for the NirnexAI chatbot.
# Copy to .env next to docker-compose.yml and adjust.

# Public hostname for automatic HTTPS via Let's Encrypt.
# Leave empty to serve plain HTTP on :80 (local/dev, or behind your own TLS).
CADDY_DOMAIN=
# ACME contact email (recommended when CADDY_DOMAIN is set).
CADDY_EMAIL=admin@nirnexai.com

# Browser origin allowed by the backend CORS policy.
# In the default single-host setup the browser only talks to Caddy, and the
# backend is reached via the proxy, so this is the public origin above.
# e.g. http://localhost   or   https://chat.nirnexai.com
CORS_ORIGIN=http://localhost
