# =========================================================
# NirnexAI RAG backend — environment configuration
# Copy to .env and fill in your keys.
# =========================================================

# --- Server ---
PORT=4000

# --- LLM providers -----------------------------------------
# Provider precedence: Gemini (GEMINI_API_KEY) > Groq (GROQ_API_KEY) > OpenRouter.
# Set only the keys you have; the chain falls through at runtime on errors so the
# chatbot keeps answering even when one provider is down or out of credits.
#
# Chat generation: Gemini. Free tier (ai.google.dev) with generous daily quota
# and no hard credit model. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza.....
# Gemini chat model. gemini-3.5-flash answers fast and streams fully.
GEMINI_MODEL=gemini-3.5-flash
# Gemini chat fallback: Groq (free tier, no hard credits). Get a key at https://console.groq.com/
GROQ_API_KEY=gsk_xxxx
GROQ_MODEL=openai/gpt-oss-20b
# Gemini chat fallback: OpenRouter (only used when Gemini + Groq both fail,
# or when GEMINI_API_KEY/GROQ_API_KEY are unset). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxx
# --- Chat model (OpenRouter fallback / when no Groq key) ---
#   openai/gpt-4.1        (default, cheap & fast)
#   openai/gpt-5          (smartest, more expensive)
LLM_MODEL=openai/gpt-4.1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=700   # cap output length (OpenRouter charges by token / requires credits)

# --- Embeddings --------------------------------------------
# Gemini embedding model (used automatically when GEMINI_API_KEY is set).
# v1beta supports gemini-embedding-001, gemini-embedding-2-preview, gemini-embedding-2.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# OpenRouter embedding model (used when GEMINI_API_KEY is NOT set).
# Groq has no embeddings on most accounts, so OpenRouter owns embeddings there.
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
# Groq embedding model (if your Groq account enables embed endpoints).
GROQ_EMBEDDING_MODEL=nomic-embed-text-v1.5
# NOTE: if you change embedding provider/dimensions, delete data/vectors.json so
# the stale index is rebuilt at the requested dimensionality.

# --- Retrieval ---
TOP_K=5                # number of context chunks per answer
# Confidence gate: when the top retrieval match scores below this cosine
# threshold the bot flags the answer as uncertain and refuses to guess.
MIN_CONFIDENCE=0.45
# Set to false/0 to disable the confidence gate entirely.
CONFIDENCE_GATE=true
# Hard budget for one chat turn before the SSE stream aborts (ms).
CHAT_TIMEOUT_MS=90000
# Force 128-char chunks to keep under model context if you use GPT-4.1-mini
# MAX_CONTEXT_CHARS=12000

# --- Vector store ---
# memory  -> local JSON file in data/, no external service (default)
# pinecone-> requires Pinecone credentials below
VECTOR_STORE=memory
# PINECONE_API_KEY=
# PINECONE_INDEX=
# PINECONE_ENVIRONMENT=us-east1-gcp

# --- Crawler / indexing ---
# Site(s) to crawl and index
SITE_ROOT=https://nirnexai.com
SCRAPE_URLS=https://nirnexai.com/,https://nirnexai.com/about,https://nirnexai.com/pricing,https://nirnexai.com/contact,https://nirnexai.com/blog
# Auto-index at startup when the store is empty (true/false)
AUTO_INDEX=true
# On boot, re-embed only index entries whose content hash changed (drift).
# false = never re-embed a populated store (instant boots). (true/false)
AUTO_INDEX_REFRESH=true
# Optional: Firecrawl for JS-rendered pages (get key at firecrawl.dev)
FIRECRAWL_API_KEY=

# --- Seed knowledge (our curated site KB) ---
USE_SEED_KB=true

# --- MOCK MODE (no API keys needed) ---
# true -> embeddings are deterministic hashes and chat returns streamed
#         answers built from the retrieved context. Great for offline dev.
MOCK=false

# --- Admin ---
ADMIN_TOKEN=change-me-to-a-secret
# Username + password for the admin console sign-in (HTTP-only session cookie).
ADMIN_USER=admin
ADMIN_PASS=change-me
DATA_DIR=./data

# --- Webhooks ---
# Optional URL that receives JSON events for high-intent users: buying intent,
# frustrated users, and submitted leads/demos (e.g. a Slack/Gmail/automation URL).
# Example payload: { event, query, email, ... , source: "nirnexai-chatbot", timestamp }
WEBHOOK_URL=https://hooks.example.com/notify

# --- Frontend CORS ---
# Comma-separated allow-list of origins that may call the API (no wildcard in
# production). Credentials (session cookies) require explicit origins.
CORS_ORIGIN=http://localhost:3002
# Express "trust proxy" hops. 1 = behind one reverse proxy (Caddy/nginx/PM2).
# Set to 0 when the backend is exposed directly to the internet.
TRUST_PROXY=1